# --- Backend (server/index.js; set these on Render) ---
GEMINI_API_KEY=your_gemini_key
GEMINI_MODEL=gemini-2.5-flash
PORT=8787
# Your Vercel URL(s), comma separated, no trailing slash. Leave empty for local dev.
CORS_ORIGIN=
# Optional cloud profiles
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Optional: how long (ms) successful air-quality lookups are cached. Default 600000 (10 min).
# AQI_CACHE_TTL_MS=600000

# --- Frontend (set VITE_API_URL on Vercel; leave unset locally) ---
# VITE_API_URL=https://your-api.onrender.com
